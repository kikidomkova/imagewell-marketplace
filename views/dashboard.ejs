<!DOCTYPE html>
<html lang="sk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ImageWell Marketplace - Klientska Zóna</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }
        body { background-color: #121212; color: #fff; padding: 40px; }
        
        /* HEADER BAR S OFICIÁLNYM LOGOM */
        .header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 3px solid #e5005a; padding-bottom: 15px; }
        .logo-box { display: flex; align-items: center; gap: 10px; }
        .logo-img { height: 35px; width: auto; display: block; }
        .logo-title { font-size: 20px; font-weight: 300; color: #fff; letter-spacing: 0.5px; border-left: 2px solid #e5005a; padding-left: 12px; margin-left: 5px; text-transform: uppercase; }
        
        .stats-grid { display: flex; gap: 20px; margin-bottom: 30px; }
        .stat-card { flex: 1; background: #1e1e1e; border: 1px solid #2c2c2c; padding: 20px; border-radius: 6px; border-left: 4px solid #e5005a; }
        .stat-card p { font-size: 13px; color: #888; text-transform: uppercase; }
        .stat-card h3 { font-size: 24px; margin-top: 5px; color: #fff; }

        .container { display: flex; gap: 40px; max-width: 1400px; margin: 0 auto; }
        .form-side { flex: 1; background: #1e1e1e; padding: 30px; border-radius: 8px; border: 1px solid #2c2c2c; }
        .preview-side { flex: 1; background: #1a1a1a; padding: 30px; border-radius: 8px; display: flex; flex-direction: column; align-items: center; }
        
        h2 { margin-bottom: 20px; color: #fff; font-size: 20px; }
        label { display: block; margin: 15px 0 5px; color: #aaa; font-size: 14px; }
        select, input { width: 100%; padding: 12px; background: #2c2c2c; border: 1px solid #3c3c3c; color: #fff; border-radius: 4px; font-size: 15px; }
        select:focus, input:focus { border-color: #e5005a; outline: none; }
        
        .capacity-badge { padding: 10px; border-radius: 4px; font-weight: bold; font-size: 14px; text-align: center; margin-top: 15px; background: #252525; border: 1px solid #333; }

        .totem { width: 100%; max-width: 480px; height: 240px; background: #000; border: 8px solid #222; border-radius: 8px; box-shadow: 0 0 30px rgba(229,0,90,0.15); overflow: hidden; margin-top: 20px; }
        .totem-screen { width: 100%; height: 100%; object-fit: fill; }
        
        .btn-submit { background: #e5005a; color: white; border: none; padding: 14px; width: 100%; border-radius: 4px; font-weight: bold; cursor: pointer; margin-top: 20px; font-size: 15px; transition: 0.2s; }
        .btn-submit:hover { background: #c2004c; }
        
        .map-box { width: 100%; height: 220px; margin-top: 15px; border-radius: 4px; overflow: hidden; border: 1px solid #333; }
        iframe { width: 100%; height: 100%; border: 0; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 40px; background: #1e1e1e; border-radius: 6px; overflow: hidden; }
        th, td { padding: 12px 15px; text-align: left; border-bottom: 1px solid #2c2c2c; }
        th { background: #151515; color: #aaa; font-size: 13px; }
        
        .status { padding: 6px 12px; border-radius: 4px; font-size: 12px; font-weight: bold; display: inline-block; text-align: center; }
        .status.wait { background: #e67e22; color: #fff; }
        .status.pay { background: #00ff88; color: #000; cursor: pointer; border: 2px solid #00ff88; font-weight: 800; }
        .status.success { background: #2ecc71; color: #fff; }

        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 9999; justify-content: center; align-items: center; }
        .modal-content { background: #1e1e1e; padding: 40px; border-radius: 12px; max-width: 450px; width: 100%; border: 2px solid #e5005a; box-shadow: 0 0 40px rgba(229,0,90,0.3); }
        .pay-option { background: #2c2c2c; padding: 18px; border-radius: 6px; margin-bottom: 15px; cursor: pointer; border: 1px solid #3c3c3c; text-align: left; }
        .pay-option:hover { border-color: #e5005a; }
        
        .loader { display: none; margin: 20px auto; border: 4px solid #333; border-top: 4px solid #00ff88; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .invoice-details-box { background: #151515; padding: 15px; border-radius: 6px; border: 1px dashed #3498db; text-align: left; font-size: 14px; color: #ccc; margin-top: 15px; }
        .invoice-details-box span { color: #fff; font-weight: bold; font-family: monospace; }
    </style>
</head>
<body>

    <div id="paymentModal" class="modal">
        <div class="modal-content">
            <h2 style="color:#fff; margin-bottom:5px; text-align:center;">🔒 Platobná brána</h2>
            <p style="color:#666; font-size:13px; margin-bottom:25px; text-align:center;">ImageWell Secure Paywall</p>
            
            <div id="selectionZone">
                <div class="pay-option" onclick="selectPaymentMethod('card')">
                    <strong style="color:#00ff88; font-size:16px;">💳 Platba kartou online</strong>
                    <p style="font-size:12px; color:#aaa; margin-top:4px;">Okamžité nasadenie do vysielania Avemea</p>
                </div>
                
                <div class="pay-option" onclick="selectPaymentMethod('invoice')">
                    <strong style="color:#3498db; font-size:16px;">📄 Prevodom na zálohovú faktúru</strong>
                    <p style="font-size:12px; color:#aaa; margin-top:4px;">Generovanie platobných údajov a VS</p>
                </div>
            </div>

            <div id="cardFields" style="display:none; margin-top:15px;">
                <label>Číslo platobnej karty:</label>
                <input type="text" id="cardNumber" placeholder="4500 1234 5678 9101" maxlength="19" style="text-align:center; letter-spacing:2px;">
                <div style="display:flex; gap:10px; margin-top:10px;">
                    <div style="flex:1;">
                        <label>Platnosť:</label>
                        <input type="text" placeholder="MM/YY" maxlength="5" style="text-align:center;">
                    </div>
                    <div style="flex:1;">
                        <label>CVC:</label>
                        <input type="password" placeholder="***" maxlength="3" style="text-align:center;">
                    </div>
                </div>
                <button class="btn-submit" style="background:#00ff88; color:#000;" onclick="executePayment('card')">Autorizovať transakciu</button>
            </div>

            <div id="invoiceFields" style="display:none; margin-top:15px;">
                <div class="invoice-details-box">
                    Banka: <span>Tatra Banka, a.s.</span><br>
                    IBAN: <span>SK81 1100 0000 0029 1234 5678</span><br>
                    Suma: <span style="color:#00ff88;" id="popPrice">-- €</span><br>
                    Variabilný symbol: <span id="popVS">--</span>
                </div>
                <button class="btn-submit" style="background:#3498db;" onclick="executePayment('invoice')">Potvrdiť vygenerovanie faktúry</button>
            </div>

            <div id="loadingZone" style="display:none; text-align:center; margin-top:20px;">
                <div class="loader"></div>
                <p style="color:#00ff88; font-weight:bold; font-size:15px;" id="loadingText">Spracovávam...</p>
            </div>

            <button class="btn-submit" id="cancelPayBtn" style="background:#333; margin-top:15px;" onclick="closePaymentModal()">Zrušiť</button>
        </div>
    </div>

    <div class="header-bar">
        <div class="logo-box">
            <img src="https://www.imagewell.eu/asset/web/logo.svg" alt="ImageWell Logo" class="logo-img">
            <div class="logo-title">Marketplace</div>
        </div>
        <div style="font-size:14px; color:#aaa;">Zákaznícka sekcia | <a href="/" style="color:#e5005a; text-decoration:none; font-weight:bold;">Odhlásiť sa</a></div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <p>Rezervované dni celkovo</p>
            <h3><%= stats.days %> dní</h3>
        </div>
        <div class="stat-card">
            <p>Aktívne vysielané reklamy</p>
            <h3><%= stats.active %></h3>
        </div>
        <div class="stat-card" style="border-left-color: #2ecc71;">
            <p>Celkový objem investícií</p>
            <h3 style="color:#2ecc71;"><%= stats.spent %> €</h3>
        </div>
    </div>

    <div class="container">
        <div class="form-side">
            <h2>Nová rezervácia plochy</h2>
            <form action="/submit-campaign" method="POST" enctype="multipart/form-data" onsubmit="return validateForm()">
                
                <label>Vyberte digitálnu plochu z Avemea:</label>
                <select name="led" id="ledSelect" onchange="triggerCapacityCheck()">
                    <option value="BA08 Apolo (576x224)">BA08 Apolo (576x224 px)</option>
                    <option value="BA_28 Fresh (576x224)">BA_28 Fresh (576x224 px)</option>
                    <option value="BA 09 Bajkalska (576x224)">BA 09 Bajkalska (576x224 px)</option>
                    <option value="BA_11 Stanica (512x256)">BA_11 Stanica (512x256 px)</option>
                    <option value="BA06 Drudop (576x224)">BA06 Drudop (576x224 px)</option>
                    <option value="BA10 vyjazd (1440x528)">BA10 výjazd (1440x528 px)</option>
                    <option value="BA10 prijazd (1440x528)">BA10 príjazd (1440x528 px)</option>
                </select>

                <div class="map-box">
                    <iframe id="mapIframe" src=""></iframe>
                </div>

                <div style="display:flex; gap:15px;">
                    <div style="flex:1;">
                        <label>Dátum od:</label>
                        <input type="date" name="startDate" id="startDate" required value="2026-06-01" onchange="triggerCapacityCheck()">
                    </div>
                    <div style="flex:1;">
                        <label>Dátum do:</label>
                        <input type="date" name="endDate" id="endDate" required value="2026-06-07" onchange="triggerCapacityCheck()">
                    </div>
                </div>

                <div id="capacityBadge" class="capacity-badge">Preverujem obsadenosť...</div>

                <div style="display:flex; gap:15px; align-items:center;">
                    <div style="flex:1;">
                        <label>Požadované trvanie spotu:</label>
                        <select name="loopLength" id="loopLength" onchange="updateRequiredRes()">
                            <option value="10">10 sekúnd (Základná slučka)</option>
                            <option value="20">20 sekúnd</option>
                            <option value="30">30 sekúnd</option>
                            <option value="60">60 sekúnd (Max limit videa)</option>
                        </select>
                    </div>
                    <div style="flex:1; background:#252525; padding:12px; border-radius:4px; margin-top:33px; border:1px solid #333; text-align:center;">
                        <span style="font-size:12px; color:#888; text-transform:uppercase;">Požadovaný rozmer:</span><br>
                        <strong id="requiredRes" style="color:#e5005a;">576 x 224 px</strong>
                    </div>
                </div>

                <label>Nahrajte podklad (Presný rozmer):</label>
                <input type="file" name="file" id="fileInput" accept="image/*,video/mp4" required onchange="previewMedia(this)">

                <button type="submit" class="btn-submit">Odoslať kampaň na posúdenie</button>
            </form>
        </div>

        <div class="preview-side">
            <h2>Vizuálny náhľad plochy</h2>
            <div class="totem">
                <div id="totemContent" style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#444; font-size:14px;">
                    <span>Čaká sa na grafický podklad</span>
                </div>
            </div>
        </div>
    </div>

    <h2>Moje objednané plochy</h2>
    <table>
        <thead>
            <tr>
                <th>Zariadenie v Avemeo</th>
                <th>Termín kampane</th>
                <th>Dĺžka</th>
                <th>Cena</th>
                <th>Podklad</th>
                <th>Stav kampane</th>
            </tr>
        </thead>
        <tbody>
            <% orders.forEach(order => { %>
                <tr>
                    <td><strong><%= order.led %></strong></td>
                    <td><%= order.startDate %> do <%= order.endDate %> (<%= order.days %> dní)</td>
                    <td><%= order.loopLength %>s</td>
                    <td style="color:#2ecc71; font-weight:bold;"><%= order.price %> €</td>
                    <td><a href="<%= order.fileUrl %>" target="_blank" style="color:#e5005a; text-decoration:none;"><%= order.fileName %></a></td>
                    <td>
                        <% if(order.status === 'Schválené (Čaká na platbu)') { %>
                            <span class="status pay" onclick="openPaymentModal('<%= order.id %>', '<%= order.price %>')">💳 ZAPLATIŤ</span>
                        <% } else { %>
                            <span class="status <%= order.status === 'Čaká na schválenie' ? 'wait' : 'success' %>"><%= order.status %></span>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <script>
        let selectedOrderId = null;
        
        // REÁLNE EMBEDOVANÉ MAPY PRE BRATISLAVU PRE KAŽDÚ PLOCHU
        const mapLinks = {
            "BA08 Apolo (576x224)": "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2661.7617029541316!2d17.1264426!3d48.1533519!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x471ba2b2f567b43f%3A0x6fb878ec94b30171!2zxaB1bHRpbnNrYSAxLCA4MTEgMDcgQnJhdGlzbGF2YQ!5e0!3m2!1ssk!2ssk!4v1716710000000",
            "BA_28 Fresh (576x224)": "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2662.34891108215!2d17.142211!3d48.142122!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x471ba2ee325fa9eb%3A0x89fb4d515a88741e!2zUHLtdXN0YXZuw6EsIDgyMSAwOSBCcmF0aXNsYXZh!5e0!3m2!1ssk!2ssk!4v1716710100000",
            "BA 09 Bajkalska (576x224)": "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2661.42111192834!2d17.139981!3d48.159822!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x471ba2c67efca8ef%3A0x1b77ee4b29bb31d2!2sQmFqa2Fsc2vDoSwgODMxIDA0IEJyYXRpc2xhdmE!5e0!3m2!1ssk!2ssk!4v1716710200000",
            "BA_11 Stanica (512x256)": "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2661.55112102914!2d17.151122!3d48.157211!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x471ba2ceef8e2ba1%3A0x6abfa7211ba1efef!2zVG9tw6HFoWlrb3ZhLCA4MjEgMDEgQnJhdGlzbGF2YQ!5e0!3m2!1ssk!2ssk!4v1716710300000",
            "BA06 Drudop (576x224)": "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2661.12111029141!2d17.123321!3d48.165411!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x471ba2bbefae8b1d%3A0x5eefea2b2bbefae!2zTWlsZXRpxI1vdmEsIDgzMSAwNCBCcmF0aXNsYXZh!5e0!3m2!1ssk!2ssk!4v1716710400000",
            "BA10 vyjazd (1440x528)": "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2663.92111028194!2d17.181122!3d48.112211!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x471ba3efefae8b1d%3A0x4eefea2b2bbaeee!2zRDIgVyYdeadmZCwgQnJhdGlzbGF2YQ!5e0!3m2!1ssk!2ssk!4v1716710500000",
            "BA10 prijazd (1440x528)": "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2663.82111028194!2d17.180011!3d48.114411!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x471ba3efefae8b1d%3A0x4eefea2b2bbaeee!2zRDIgUHXtY2hyeWQsIEJyYXRpc2xhdmE!5e0!3m2!1ssk!2ssk!4v1716710600000"
        };

        function updateRequiredRes() {
            const led = document.getElementById('ledSelect').value;
            const resEl = document.getElementById('requiredRes');
            
            if (led.includes('Stanica')) {
                resEl.innerText = "512 x 256 px";
            } else if (led.includes('1440x528')) {
                resEl.innerText = "1440 x 528 px";
            } else {
                resEl.innerText = "576 x 224 px";
            }
        }

        function triggerCapacityCheck() {
            const led = document.getElementById('ledSelect').value;
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            
            // Nastavenie reálnej mapy
            document.getElementById('mapIframe').src = mapLinks[led] || "";
            updateRequiredRes();

            fetch('/check-capacity', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ led, startDate, endDate })
            })
            .then(res => res.json())
            .then(data => {
                const badge = document.getElementById('capacityBadge');
                badge.innerText = data.status;
                badge.style.color = data.color;
            });
        }

        function previewMedia(input) {
            const container = document.getElementById('totemContent');
            const file = input.files[0];
            if (!file) return;
            const url = URL.createObjectURL(file);
            if (file.type.includes('video')) {
                container.innerHTML = `<video src="${url}" class="totem-screen" autoplay loop muted></video>`;
            } else {
                container.innerHTML = `<img src="${url}" class="totem-screen">`;
            }
        }

        function validateForm() {
            const file = document.getElementById('fileInput').files[0];
            const loop = parseInt(document.getElementById('loopLength').value);
            if (file && file.type.includes('video') && loop > 60) {
                alert("Chyba: Maximálne trvanie videa je 60 sekúnd!");
                return false;
            }
            return true;
        }

        function openPaymentModal(orderId, price) {
            selectedOrderId = orderId;
            document.getElementById('popPrice').innerText = price + " €";
            document.getElementById('popVS').innerText = "2026" + Math.floor(1000 + Math.random() * 9000);
            document.getElementById('paymentModal').style.display = 'flex';
            document.getElementById('selectionZone').style.display = 'block';
        }

        function closePaymentModal() {
            document.getElementById('paymentModal').style.display = 'none';
            document.getElementById('cardFields').style.display = 'none';
            document.getElementById('invoiceFields').style.display = 'none';
            document.getElementById('loadingZone').style.display = 'none';
            document.getElementById('cancelPayBtn').style.display = 'block';
        }

        function selectPaymentMethod(method) {
            document.getElementById('selectionZone').style.display = 'none';
            if (method === 'card') document.getElementById('cardFields').style.display = 'block';
            else document.getElementById('invoiceFields').style.display = 'block';
        }

        function executePayment(method) {
            if (method === 'card') {
                if(document.getElementById('cardNumber').value.length < 12) {
                    alert("Chyba: Neplatný formát karty!");
                    return;
                }
                document.getElementById('cardFields').style.display = 'none';
                document.getElementById('loadingText').innerText = "Prepájam na 3D Secure bankovú autorizáciu...";
            } else {
                document.getElementById('invoiceFields').style.display = 'none';
                document.getElementById('loadingText').innerText = "Generujem predfaktúru do účtovného systému...";
            }

            document.getElementById('loadingZone').style.display = 'block';
            document.getElementById('cancelPayBtn').style.display = 'none';

            setTimeout(() => {
                fetch('/pay-campaign', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderId: selectedOrderId, method: method })
                })
                .then(res => res.json())
                .then(data => {
                    if(data.success) {
                        closePaymentModal();
                        alert("💰 Platba úspešne spracovaná a priradená!");
                        window.location.reload();
                    }
                });
            }, 2500);
        }

        triggerCapacityCheck();
    </script>
</body>
</html>