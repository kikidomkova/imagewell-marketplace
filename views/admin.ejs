<!DOCTYPE html>
<html lang="sk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ImageWell - Admin Control</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
        body { background-color: #121212; color: #fff; padding: 40px; }
        
        .header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 2px solid #ff0055; padding-bottom: 15px; }
        .logo-box { font-size: 28px; font-weight: 900; color: #ff0055; text-transform: uppercase; letter-spacing: 1px; }
        .logo-box span { color: #fff; font-weight: 300; font-size: 20px; }

        .global-stats { display: flex; gap: 20px; margin-bottom: 30px; }
        .stat-card { flex: 1; background: #1e1e1e; border: 1px solid #2c2c2c; padding: 20px; border-radius: 6px; border-left: 4px solid #2ecc71; }
        .stat-card p { font-size: 13px; color: #888; text-transform: uppercase; }
        .stat-card h3 { font-size: 24px; margin-top: 5px; }

        table { width: 100%; border-collapse: collapse; margin-top: 20px; background:#1e1e1e; border-radius: 6px; overflow:hidden; }
        th, td { padding: 15px; text-align: left; border-bottom: 1px solid #2c2c2c; }
        th { background-color: #151515; color: #aaa; font-size: 13px; }
        
        .status-badge { padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }
        .pending { background: #e67e22; }
        .approved { background: #3498db; }
        .success { background: #2ecc71; }
        
        .btn { padding: 6px 12px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 13px; margin-right: 5px; }
        .btn-approve { background: #2ecc71; color: #fff; }
        .btn-reject { background: #e74c3c; color: #fff; }
        video, img { width: 120px; height: 50px; background: #000; object-fit: fill; border-radius: 4px; }
        
        .push-notification { position: fixed; top: 20px; right: -350px; width: 320px; background: #ff0055; color: white; padding: 20px; border-radius: 8px; transition: 0.5s; z-index: 9999; }
        .push-notification.show { right: 20px; }
    </style>
</head>
<body>

    <div id="push-box" class="push-notification">
        <h4>🚨 REKLAMA NA SCHVÁLENIE!</h4>
        <p id="push-text">Pribudla nová žiadosť.</p>
        <button style="margin-top: 10px; background: white; color: #ff0055; border: none; padding: 5px; width: 100%; cursor: pointer; font-weight: bold;" onclick="window.location.reload()">Aktualizovať</button>
    </div>

    <div class="header-bar">
        <div class="logo-box">ImageWell <span>Management Panel</span></div>
        <a href="/" style="color:#aaa; text-decoration:none; font-size:14px;">Odhlásiť sa</a>
    </div>

    <div class="global-stats">
        <div class="stat-card">
            <p>Uzatvorený obrat z marketplace</p>
            <h3 style="color:#2ecc71;"><%= globalStats.revenue %> €</h3>
        </div>
        <div class="stat-card" style="border-left-color:#3498db;">
            <p>Celkový objem vysielacích dní</p>
            <h3 style="color:#3498db;"><%= globalStats.days %> dní</h3>
        </div>
    </div>

    <h2>Prehľad žiadostí o nasadenie do Avemea</h2>

    <% if (orders.length === 0) { %>
        <p style="margin-top:20px; color:#666;">Žiadne aktívne požiadavky v databáze.</p>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>Termín</th>
                    <th>Zariadenie v Avemeo</th>
                    <th>Dĺžka spotu</th>
                    <th>Finálna Cena</th>
                    <th>Náhľad kreatívy</th>
                    <th>Stav</th>
                    <th>Akcia</th>
                </tr>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                    <tr>
                        <td><%= order.startDate %> do <%= order.endDate %> (<%= order.days %> dní)</td>
                        <td><strong><%= order.led %></strong></td>
                        <td><%= order.loopLength %>s (<span style="font-size:11px; color:#888;"><%= order.fileType %></span>)</td>
                        <td style="color:#2ecc71; font-weight:bold;"><%= order.price %> €</td>
                        <td>
                            <% if (order.fileType === 'video') { %>
                                <video src="<%= order.fileUrl %>" controls></video>
                            <% } else { %>
                                <img src="<%= order.fileUrl %>">
                            <% } %>
                        </td>
                        <td>
                            <span class="status-badge <%= order.status === 'Čaká na schválenie' ? 'pending' : (order.status.startsWith('Zaplatené') ? 'success' : 'approved') %>">
                                <%= order.status %>
                            </span>
                        </td>
                        <td>
                            <form action="/admin/action" method="POST" style="display:inline;">
                                <input type="hidden" name="orderId" value="<%= order.id %>">
                                <% if (order.status === 'Čaká na schválenie') { %>
                                    <button type="submit" name="action" value="approve" class="btn btn-approve">Schváliť</button>
                                    <button type="submit" name="action" value="reject" class="btn btn-reject">Zamietnuť</button>
                                <% } %>
                                <button type="submit" name="action" value="delete" class="btn" style="background:#555; color:#fff;">Zmazať</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        socket.on('newCampaignNotification', (data) => {
            document.getElementById('push-text').innerText = `Kampaň pre: ${data.led}`;
            document.getElementById('push-box').classList.add('show');
            
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const oscillator = audioCtx.createOscillator();
            oscillator.frequency.setValueAtTime(880, audioCtx.currentTime);
            oscillator.connect(audioCtx.destination);
            oscillator.start();
            oscillator.stop(audioCtx.currentTime + 0.15);
        });
    </script>
</body>
</html>