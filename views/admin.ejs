<!DOCTYPE html>
<html lang="sk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ImageWell - Admin Control Center</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }
        body { background-color: #0d0d0d; color: #f5f5f7; padding: 40px; }
        
        .header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; border-bottom: 3px solid #e5005a; padding-bottom: 20px; }
        
        .logo-box { display: flex; align-items: center; gap: 10px; text-decoration: none; }
        .logo-img { height: 35px; width: auto; display: block; }
        .logo-title { font-size: 18px; font-weight: 300; color: #ffffff; letter-spacing: 0.5px; border-left: 2px solid #e5005a; padding-left: 12px; margin-left: 5px; text-transform: uppercase; }

        .btn-logout { color: #888; text-decoration: none; font-size: 14px; padding: 8px 16px; border: 1px solid #222; border-radius: 4px; transition: 0.2s; }
        .btn-logout:hover { color: #e5005a; border-color: #e5005a; background: rgba(229, 0, 90, 0.05); }

        h2 { font-size: 22px; font-weight: 600; margin-bottom: 20px; color: #fff; display: flex; align-items: center; gap: 10px; }
        h2::before { content: ''; display: inline-block; width: 4px; height: 22px; background: #e5005a; border-radius: 2px; }

        .global-stats { display: flex; gap: 20px; margin-bottom: 40px; }
        .stat-card { flex: 1; background: linear-gradient(145deg, #141414, #1a1a1a); border: 1px solid #222; padding: 25px; border-radius: 8px; border-left: 4px solid #e5005a; box-shadow: 0 4px 20px rgba(0,0,0,0.3); }
        .stat-card p { font-size: 12px; color: #888; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; }
        .stat-card h3 { font-size: 32px; margin-top: 8px; font-weight: 700; color: #fff; font-family: monospace; }
        
        .table-container { background: #141414; border: 1px solid #222; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 25px rgba(0,0,0,0.4); }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th, td { padding: 16px 20px; border-bottom: 1px solid #222; vertical-align: middle; }
        th { background-color: #1a1a1a; color: #aaa; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; }
        tr:hover td { background-color: #181818; }
        
        .status-badge { padding: 6px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; display: inline-block; text-transform: uppercase; }
        .pending { background: rgba(230, 126, 34, 0.15); color: #e67e22; border: 1px solid rgba(230, 126, 34, 0.3); }
        .approved { background: rgba(52, 152, 219, 0.15); color: #3498db; border: 1px solid rgba(52, 152, 219, 0.3); }
        .success { background: rgba(46, 204, 113, 0.15); color: #2ecc71; border: 1px solid rgba(46, 204, 113, 0.3); }
        
        .btn { padding: 8px 14px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 12px; text-transform: uppercase; transition: 0.2s; }
        .btn-approve { background: #2ecc71; color: #051a0e; margin-right: 6px; }
        .btn-approve:hover { background: #27ae60; }
        .btn-reject { background: #e74c3c; color: #fff; margin-right: 6px; }
        .btn-reject:hover { background: #c0392b; }
        .btn-delete { background: #2c2c2c; color: #aaa; border: 1px solid #3c3c3c; }
        
        .media-preview { width: 140px; height: 55px; background: #000; object-fit: fill; border-radius: 4px; border: 1px solid #333; display: block; }
        
        .push-notification { position: fixed; top: 20px; right: -380px; width: 350px; background: linear-gradient(135deg, #e5005a, #b3003b); color: white; padding: 22px; border-radius: 8px; transition: 0.5s; z-index: 9999; }
        .push-notification.show { right: 20px; }
        .push-btn { margin-top: 12px; background: #fff; color: #e5005a; border: none; padding: 6px; width: 100%; cursor: pointer; font-weight: bold; border-radius: 4px; font-size: 12px; text-transform: uppercase; }
    </style>
</head>
<body>

    <div id="push-box" class="push-notification">
        <h4>🚨 REKLAMA NA SCHVÁLENIE!</h4>
        <p id="push-text">Zákazník práve odoslal novú požiadavku do CMS.</p>
        <button class="push-btn" onclick="window.location.reload()">Aktualizovať zoznam</button>
    </div>

    <div class="header-bar">
        <div class="logo-box">
            <img src="https://www.imagewell.eu/asset/web/logo.svg" alt="ImageWell Logo" class="logo-img">
            <div class="logo-title">Management Panel</div>
        </div>
        <a href="/" class="btn-logout">Odhlásiť sa</a>
    </div>

    <div class="global-stats">
        <div class="stat-card">
            <p>Uzatvorený obrat z marketplace</p>
            <h3 style="color:#2ecc71;"><%= globalStats.revenue %> €</h3>
        </div>
        <div class="stat-card" style="border-left-color:#3498db;">
            <p>Celkový objem vysielacích dní</p>
            <h3 style="color:#3498db;"><%= globalStats.days %> dní</h3>
        </div>
        <div class="stat-card" style="border-left-color:#e67e22;">
            <p>Počet evidovaných kampaní</p>
            <h3 style="color:#e67e22;"><%= orders.length %> zmlúv</h3>
        </div>
    </div>

    <h2>Prehľad žiadostí o nasadenie do Avemea</h2>

    <div class="table-container">
        <% if (orders.length === 0) { %>
            <p style="padding: 30px; text-align: center; color: #666; font-size: 15px;">V databáze sa nenachádzajú žiadne aktívne požiadavky od klientov.</p>
        <% } else { %>
            <table>
                <thead>
                    <tr>
                        <th>Plánovaný termín</th>
                        <th>Zariadenie v Avemeo</th>
                        <th>Dĺžka spotu</th>
                        <th>Finálna cena</th>
                        <th>Kreatíva (Náhľad)</th>
                        <th>Stav zmluvy</th>
                        <th style="text-align: right;">Akcia a Riadenie</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach(order => { %>
                        <tr>
                            <td>
                                <span style="font-weight: 600;"><%= order.startDate %></span> 
                                <span style="color:#666; font-size:12px;">do</span> 
                                <span style="font-weight: 600;"><%= order.endDate %></span>
                                <br><span style="font-size:11px; color:#888;"><%= order.days %> dní v prevádzke</span>
                            </td>
                            <td>
                                <strong style="color: #fff;"><%= order.led.split(' (')[0] %></strong>
                                <br><span style="font-size:11px; color:#666;">Požadované rozlíšenie: <%= order.led.includes('Stanica') ? '512x256px' : (order.led.includes('1440x528') ? '1440x528px' : '576x224px') %></span>
                            </td>
                            <td>
                                <span style="font-family: monospace; font-size: 14px;"><%= order.loopLength %>s</span>
                                <br><span style="font-size:10px; color:#888; text-transform:uppercase; font-weight:bold;"><%= order.fileType %></span>
                            </td>
                            <td style="color:#2ecc71; font-weight:700; font-size:15px; font-family: monospace;"><%= order.price %> €</td>
                            <td>
                                <% if (order.fileType === 'video') { %>
                                    <video src="<%= order.fileUrl %>" class="media-preview" controls muted></video>
                                <% } else { %>
                                    <img src="<%= order.fileUrl %>" class="media-preview">
                                <% } %>
                            </td>
                            <td>
                                <span class="status-badge <%= order.status === 'Čaká na schválenie' ? 'pending' : (order.status.startsWith('Zaplatené') ? 'success' : 'approved') %>">
                                    <%= order.status %>
                                </span>
                            </td>
                            <td style="text-align: right;">
                                <form action="/admin/action" method="POST" style="display:inline-block;">
                                    <input type="hidden" name="orderId" value="<%= order.id %>">
                                    <% if (order.status === 'Čaká na schválenie') { %>
                                        <button type="submit" name="action" value="approve" class="btn btn-approve">Schváliť</button>
                                        <button type="submit" name="action" value="reject" class="btn btn-reject">Zamietnuť</button>
                                    <% } %>
                                    <button type="submit" name="action" value="delete" class="btn btn-delete">Zmazať</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        socket.on('newCampaignNotification', (data) => {
            const shortLed = data.led.split(' (')[0];
            document.getElementById('push-text').innerText = `Klient nahral podklad na zariadenie: ${shortLed}`;
            document.getElementById('push-box').classList.add('show');
            
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const oscillator = audioCtx.createOscillator();
            oscillator.frequency.setValueAtTime(880, audioCtx.currentTime);
            oscillator.connect(audioCtx.destination);
            oscillator.start();
            oscillator.stop(audioCtx.currentTime + 0.15);
        });
    </script>
</body>
</html>