<!DOCTYPE html>
<html lang="sk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prihlásenie | ImageWell</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #121212; /* Tmavé pozadie celej stránky */
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .login-container {
            background-color: #1e1e1e; /* Svetlejšia tmavá pre box formulára */
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5); /* Moderný tieň */
            width: 100%;
            max-width: 400px;
        }
        .logo-container {
            text-align: center;
            margin-bottom: 30px;
        }
        .logo-container img {
            max-width: 180px;
            margin-bottom: 15px;
        }
        .logo-text {
            font-size: 22px;
            font-weight: 600;
            letter-spacing: 1px;
            color: #f0f0f0;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: #aaaaaa;
        }
        .form-group input {
            width: 100%;
            padding: 14px;
            background-color: #2c2c2c;
            border: 1px solid #3c3c3c;
            border-radius: 6px;
            color: #ffffff;
            font-size: 15px;
            transition: all 0.3s ease;
        }
        .form-group input:focus {
            outline: none;
            border-color: #007bff; /* Modrý akcent pri kliknutí */
            box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.25);
        }
        .submit-btn {
            width: 100%;
            padding: 14px;
            background-color: #007bff;
            border: none;
            border-radius: 6px;
            color: #ffffff;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s ease;
            margin-top: 10px;
        }
        .submit-btn:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="logo-container">
            <img src="https://via.placeholder.com/180x60/1e1e1e/ffffff?text=ImageWell+Logo" alt="ImageWell Logo">
            <div class="logo-text">Firemný Portál</div>
        </div>

        <form action="/login" method="POST">
            <div class="form-group">
                <label for="username">Login (E-mail)</label>
                <input type="text" id="username" name="username" required placeholder="napr. kapas@imagewell.eu">
            </div>
            <div class="form-group">
                <label for="password">Heslo</label>
                <input type="password" id="password" name="password" required placeholder="Zadajte vaše heslo">
            </div>
            <button type="submit" class="submit-btn">Prihlásiť sa</button>
        </form>
    </div>

</body>
</html>
