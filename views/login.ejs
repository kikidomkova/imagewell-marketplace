<!DOCTYPE html>
<html lang="sk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ImageWell Marketplace - Prihlásenie</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
        body { background-color: #121212; color: #ffffff; height: 100vh; display: flex; justify-content: center; align-items: center; }
        .login-card { background: #1e1e1e; padding: 40px; border-radius: 8px; width: 100%; max-width: 400px; border: 1px solid #2c2c2c; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }
        h1 { font-size: 24px; margin-bottom: 8px; text-align: center; color: #ff0055; text-transform: uppercase; }
        p.subtitle { text-align: center; color: #666; font-size: 14px; margin-bottom: 30px; }
        label { display: block; margin-bottom: 8px; color: #aaa; font-size: 14px; }
        input { width: 100%; padding: 12px; background: #2a2a2a; border: 1px solid #3d3d3d; color: #fff; border-radius: 4px; margin-bottom: 20px; font-size: 16px; }
        input:focus { border-color: #ff0055; outline: none; }
        button { width: 100%; background: #ff0055; color: white; border: none; padding: 14px; border-radius: 4px; font-size: 16px; font-weight: bold; cursor: pointer; transition: 0.2s; }
        button:hover { background: #ff3377; }
        .error-msg { background: #ff4444; color: white; padding: 10px; border-radius: 4px; font-size: 14px; margin-bottom: 20px; text-align: center; }
        .link-zone { text-align: center; margin-top: 25px; font-size: 14px; border-top: 1px solid #2c2c2c; padding-top: 15px; }
        .link-zone a { color: #ff0055; text-decoration: none; font-weight: bold; }
        .link-zone a:hover { text-decoration: underline; }
    </style>
</head>
<body>

    <div class="login-card">
        <h1>ImageWell</h1>
        <p class="subtitle">Digital Signage Marketplace</p>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error-msg"><%= error %></div>
        <% } %>

        <form action="/login" method="POST">
            <label for="username">Používateľské meno</label>
            <input type="text" id="username" name="username" placeholder="Napr. inzercia12" required>

            <label for="password">Heslo</label>
            <input type="password" id="password" name="password" placeholder="••••••••" required>

            <button type="submit">Prihlásiť sa</button>
        </form>
        
        <div class="link-zone">
            Nemáte ešte účet? <a href="/register">Zaregistrujte sa tu</a>
        </div>
    </div>

</body>
</html>